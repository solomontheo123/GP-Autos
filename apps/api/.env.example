DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gp_autos
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

SESSION_SECRET=replace-with-local-secret
PAYSTACK_SECRET_KEY=replace-with-test-secret
PAYSTACK_PUBLIC_KEY=replace-with-test-public-key
PAYSTACK_CALLBACK_URL=http://localhost:3000/orders/confirmation

MAILGUN_API_KEY=replace-with-mailgun-key
MAILGUN_DOMAIN=replace-with-mailgun-domain
MAILGUN_FROM_EMAIL=GP Autos <orders@example.com>

